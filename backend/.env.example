# Copy this file to .env and fill in your own values
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vendsphere
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000

# ==========================================
# SMTP Email Notification Configuration
# ==========================================
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-16-digit-app-password
#   SMTP_FROM="VendSphere Procurement" <your-email@gmail.com>
#
# For Outlook / Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# For SendGrid / Mailgun / Amazon SES:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=your-sendgrid-api-key
#
# Default / Local Development:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VendSphere Procurement" <notifications@vendsphere.com>
