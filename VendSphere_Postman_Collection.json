{
	"info": {
		"_postman_id": "vendsphere-api-collection-v1",
		"name": "VendSphere API Collection",
		"description": "Postman Collection for testing VendSphere Multi-Tenant Vendor & Procurement Management SaaS API endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "tenantId",
			"value": "acme",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. System & Health",
			"item": [
				{
					"name": "API Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"health"
							]
						},
						"description": "Checks backend API and PostgreSQL database connectivity."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Tenant & Auth",
			"item": [
				{
					"name": "Register New Tenant",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"companyName\": \"Acme Corp\",\n  \"subdomain\": \"acme\",\n  \"adminName\": \"Admin User\",\n  \"adminEmail\": \"admin@acme.com\",\n  \"adminPassword\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tenants/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tenants",
								"register"
							]
						},
						"description": "Onboards a new tenant company, creates dedicated database schema, and initializes Admin user."
					},
					"response": []
				},
				{
					"name": "Tenant User Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.collectionVariables.set(\"authToken\", jsonData.token);",
									"        console.log(\"Saved authToken to collection variable!\");",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "x-tenant-id",
								"value": "{{tenantId}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@acme.com\",\n  \"password\": \"password123\",\n  \"tenantId\": \"{{tenantId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Authenticates tenant user and automatically sets `authToken` in collection variables upon success."
					},
					"response": []
				},
				{
					"name": "Get Current User Context",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-tenant-id",
								"value": "{{tenantId}}",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Fetches current logged in user details inside the tenant environment."
					},
					"response": []
				}
			]
		},
