{
  "info": {
    "_postman_id": "vendsphere-api-collection-v2",
    "name": "VendSphere API Testing Suite",
    "description": "Comprehensive Postman collection for VendSphere Multi-Tenant Vendor and Procurement Management System.\nIncludes Authentication, Risk Management, Returns & Warranty, Requisitions, RFQs, Purchase Orders, Feedback, and Billing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "acme",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Acme Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        console.log('JWT Token saved to collection variable:', json.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"email\": \"admin@acme.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Log into tenant space as Admin. Saves JWT token into {{token}} collection variable."
          }
        },
        {
          "name": "Login (J.V. Group Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        pm.collectionVariables.set('tenantId', 'jvgroup');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "jvgroup" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"jvgroup\",\n  \"email\": \"tirth@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Acme Purchaser)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"email\": \"procurement@acme.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Risk Management (Telemetry Engine)",
      "item": [
        {
          "name": "Get Risk Overview & KPI Scores",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/risks/overview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "risks", "overview"]
            },
            "description": "Calculates composite enterprise risk score (0-100), vendor delivery delays, price volatility exposure, and approval bottlenecks."
          }
        },
        {
          "name": "List All Tracked Risks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/risks?status=Active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "risks"],
              "query": [
                { "key": "status", "value": "Active" },
                { "key": "type", "value": "ALL", "disabled": true },
                { "key": "severity", "value": "Critical", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Run Fresh Assessment Scan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/risks/assess",
              "host": ["{{baseUrl}}"],
              "path": ["api", "risks", "assess"]
            },
            "description": "Forces risk engine to recalculate pipeline metrics and sync to database."
          }
        },
        {
          "name": "Mitigate Risk (Dispatches Email Alert)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mitigationPlan\": \"Expedited SLA review dispatched with primary logistics courier. Priority delivery required within 48h.\",\n  \"notifyTeam\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/risks/{{riskId}}/mitigate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "risks", "{{riskId}}", "mitigate"]
            },
            "description": "Applies mitigation action plan, marks risk as Mitigating, and triggers email alert to tirthpanchal65@gmail.com."
          }
        },
        {
          "name": "Resolve Risk",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNotes\": \"Supplier completed full delivery and price adjustment credit note verified.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/risks/{{riskId}}/resolve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "risks", "{{riskId}}", "resolve"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Returns & Warranty Lifecycle",
      "item": [
        {
          "name": "List All Return Requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/returns",
              "host": ["{{baseUrl}}"],
              "path": ["api", "returns"]
            }
          }
        },
        {
          "name": "Submit Return Request (with Warranty Check)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchaseOrderId\": \"{{purchaseOrderId}}\",\n  \"itemName\": \"APC 42U Server Rack Enclosure\",\n  \"itemCategory\": \"Hardware\",\n  \"quantityReturned\": 1,\n  \"unitPrice\": 65000,\n  \"returnReason\": \"Defective / Malfunctioning\",\n  \"itemCondition\": \"Opened\",\n  \"reasonDescription\": \"Rear door locking latch damaged on arrival.\",\n  \"warrantyPeriodDays\": 180\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/returns",
              "host": ["{{baseUrl}}"],
              "path": ["api", "returns"]
            }
          }
        },
        {
          "name": "Review Return Request (Approve / RMA)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"Approve\",\n  \"reviewNotes\": \"Warranty verified valid within 180-day coverage window. Return merchandise authorized.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/returns/{{returnId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["api", "returns", "{{returnId}}", "review"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Purchase Orders",
      "item": [
        {
          "name": "List Purchase Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase-orders"]
            }
          }
        },
        {
          "name": "Get PO Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders/{{purchaseOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase-orders", "{{purchaseOrderId}}"]
            }
          }
        },
        {
          "name": "Dispatch PO to Vendor",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders/{{purchaseOrderId}}/dispatch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase-orders", "{{purchaseOrderId}}", "dispatch"]
            }
          }
        },
        {
          "name": "Vendor Accept PO",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders/{{purchaseOrderId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase-orders", "{{purchaseOrderId}}", "accept"]
            }
          }
        },
        {
          "name": "Complete PO (Log Delivery Receipt)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryNotes\": \"Shipment fully inspected and accepted at dock 2. All items verified intact.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders/{{purchaseOrderId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase-orders", "{{purchaseOrderId}}", "complete"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Requisitions & Sourcing",
      "item": [
        {
          "name": "List Purchase Requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase-requests"]
            }
          }
        },
        {
          "name": "Create Purchase Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dell Precision Mobile Workstations\",\n  \"description\": \"Engineering workstation upgrade for Q4 CAD projects.\",\n  \"items\": [\n    {\n      \"name\": \"Dell Precision 5680 Workstation\",\n      \"quantity\": 5,\n      \"estimated_cost\": 175000\n    }\n  ],\n  \"total_estimated_cost\": 875000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/purchase-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase-requests"]
            }
          }
        },
        {
          "name": "List Sourcing RFQs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rfqs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rfqs"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard Analytics",
      "item": [
        {
          "name": "Get Executive Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard"]
            }
          }
        }
      ]
    },
    {
      "name": "7. System & Health",
      "item": [
        {
          "name": "Backend Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    }
  ]
}
